{
  "name": "motionview",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "py:clean": "node scripts/clean_py.js",
    "py:build": "node scripts/build_py.js",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config vite.config.js",
    "build:web": "vite build --config vite.config.js",
    "dev": "pnpm py:clean && pnpm py:build && tauri dev",
    "build": "pnpm py:clean && pnpm py:build && tauri build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "dotenv-cli": "^11.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.19"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "chart.js": "^4.5.1"
  }
}
